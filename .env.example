# RepoLens Environment Variables (Example)
# Copy this file to .env and fill in real values before running locally.

# GitHub OAuth App (https://github.com/settings/developers)
# Callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# OpenAI API Key (used by Spring AI for embeddings and chat streaming)
OPENAI_API_KEY=your-openai-api-key

# Token Encryption (Spring Security TextEncryptor for stored GitHub tokens)
# Salt must be a valid hex string (e.g. 16 hex characters)
APP_TOKEN_ENCRYPTOR_PASSWORD=replace-with-a-strong-encryption-password
APP_TOKEN_ENCRYPTOR_SALT=0123456789abcdef

# Application URLs
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# PostgreSQL + pgvector (matches docker-compose.yml)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/repolens
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

